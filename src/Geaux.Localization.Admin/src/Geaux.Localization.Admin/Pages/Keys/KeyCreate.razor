@page "/admin/localization/keys/create"
@using Geaux.Localization.Admin.DTOs
@inject KeyAdminService KeyService
@inject LocalizationValueAdminService ValueService
@inject CultureAdminService CultureService
@inject NavigationManager Nav

<PageTitle>Create Key</PageTitle>

<MudPaper Class="pa-6" Elevation="1">
    <MudStack Spacing="2">

        <MudText Typo="Typo.h5">Create New Key</MudText>

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        }
        else
        {
            <!-- Key Fields -->
            <MudTextField @bind-Value="_model.Key"
                          Label="Key"
                          Variant="Variant.Outlined"
                          FullWidth="true" />

            <MudTextField @bind-Value="_model.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mt-4" />

            <MudSwitch T="bool" @bind-Checked="_model.IsSystem"
                       Color="Color.Primary"
                       Label="System Key"
                       Class="mt-4" />

            <MudDivider Class="my-4" />

            <!-- Initial Values -->
            <MudText Typo="Typo.h6">Initial Values</MudText>

            @foreach (var culture in _cultures)
            {
                <MudPaper Class="pa-4 mt-2" Elevation="1">
                    <MudText Typo="Typo.subtitle2">@culture.DisplayName (@culture.CultureCode)</MudText>

                    <MudTextField @bind-Value="_values[culture.CultureCode]"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Class="mt-2" />
                </MudPaper>
            }

            <MudStack Direction="Row" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="Save">
                    Create Key
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudStack>
        }

    </MudStack>
</MudPaper>

@code {
    private LocalizationKeyDto _model = new();
    private List<LocalizationCultureDto> _cultures = new();
    private Dictionary<string, string?> _values = new();

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _cultures = await CultureService.GetAllCulturesAsync();

        // Initialize empty values for each culture
        foreach (var c in _cultures)
            _values[c.CultureCode] = string.Empty;

        _loading = false;
    }

    private async Task Save()
    {
        // Create the key
        var createdKeyId = await KeyService.CreateKeyAsync(_model);

        // Save initial values
        foreach (var culture in _cultures)
        {
            var dto = new LocalizationValueDto
            {
                KeyId = createdKeyId,
                CultureCode = culture.CultureCode,
                Value = _values[culture.CultureCode] ?? string.Empty
            };

            await ValueService.UpsertValueAsync(dto);
        }

        Nav.NavigateTo("/admin/localization/keys");
    }


    private void Cancel()
    {
        Nav.NavigateTo("/admin/localization/keys");
    }
}
