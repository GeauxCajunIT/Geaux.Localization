@page "/admin/localization/keys/edit/{Id:int}"
@using Geaux.Localization.Admin.DTOs
@inject KeyAdminService KeyService
@inject LocalizationValueAdminService ValueService
@inject CultureAdminService CultureService
@inject NavigationManager Nav

<PageTitle>Edit Key</PageTitle>

<MudPaper Class="pa-6" Elevation="1">
    <MudStack Spacing="2">

        <MudText Typo="Typo.h5">Edit Key</MudText>

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        }
        else if (_key is not null)
        {
            <!-- Key Fields -->
            <MudTextField @bind-Value="_key.Key"
                          Label="Key"
                          Variant="Variant.Outlined"
                          FullWidth="true" />

            <MudTextField @bind-Value="_key.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mt-4" />

            <MudSwitch T="bool" @bind-Checked="_key.IsSystem"
                       Color="Color.Primary"
                       Label="System Key"
                       Class="mt-4" />

            <MudDivider Class="my-4" />

            <!-- Values for each culture -->
            <MudText Typo="Typo.h6">Translations</MudText>

            @foreach (var culture in _cultures)
            {
                <MudPaper Class="pa-4 mt-2" Elevation="1">
                    <MudText Typo="Typo.subtitle2">@culture.DisplayName (@culture.CultureCode)</MudText>

                    <MudTextField @bind-Value="_values[culture.CultureCode]"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Class="mt-2"
                                  OnBlur="@(async _ => await SaveValue(culture.CultureCode))" />

                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="@(async _ => await SaveValue(culture.CultureCode))">
                        Save
                    </MudButton>
                </MudPaper>
            }

            <MudStack Direction="Row" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SaveKey">
                    Save Key
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudStack>
        }

    </MudStack>
</MudPaper>

@code {
    [Parameter] public int Id { get; set; }

    private LocalizationKeyDto? _key;
    private List<LocalizationCultureDto> _cultures = new();
    private Dictionary<string, string?> _values = new();

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        // Load key DTO
        _key = await KeyService.GetKeyAsync(Id);

        // Load cultures
        _cultures = await CultureService.GetAllCulturesAsync();

        // Load values for each culture
        foreach (var culture in _cultures)
        {
            var valuesForCulture = await ValueService.GetValuesForCultureAsync(culture.CultureCode); 
            var valueDto = valuesForCulture.FirstOrDefault(v => v.KeyId == Id); 
            _values[culture.CultureCode] = valueDto?.Value ?? string.Empty;
        }

        _loading = false;
    }

    private async Task SaveKey()
    {
        if (_key is null)
            return;

        await KeyService.UpdateKeyAsync(_key);
        Nav.NavigateTo("/admin/localization/keys");
    }

    private async Task SaveValue(string cultureCode)
    {
        if (_key is null)
            return;

        var dto = new LocalizationValueDto
        {
            KeyId = _key.Id,
            CultureCode = cultureCode,
            Value = _values[cultureCode] ?? string.Empty
        };

        await ValueService.UpsertValueAsync(dto);
    }

    private void Cancel()
    {
        Nav.NavigateTo("/admin/localization/keys");
    }
}
