@page "/admin/localization/keys"
@inject KeyAdminService KeyService
@inject NavigationManager Nav

<PageTitle>Localization Keys</PageTitle>

<MudPaper Class="pa-6" Elevation="1">
    <MudStack Spacing="3">

        <MudStack Direction="Row" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Localization Keys</MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateKey">
                Create Key
            </MudButton>
        </MudStack>

        <MudTextField @bind-Value="_search"
                      Placeholder="Search keys..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      OnDebounceIntervalElapsed="ApplySearch"
                      DebounceInterval="200"
                      FullWidth="true" />

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        }
        else
        {
            <MudExpansionPanels Multiple="true">

                @foreach (var group in _groupedKeys)
                {
                    <MudExpansionPanel Text="@group.Key">

                        <MudTable Items="group.Value" Hover="true" Dense="true">

                            <HeaderContent>
                                <MudTh>Key</MudTh>
                                <MudTh>Description</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd>@context.Key</MudTd>
                                <MudTd>@context.Description</MudTd>

                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => EditKey(context.Id))" />

                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteKey(context))" />
                                </MudTd>
                            </RowTemplate>

                        </MudTable>

                    </MudExpansionPanel>
                }

            </MudExpansionPanels>
        }

    </MudStack>
</MudPaper>

@code {
    private List<LocalizationKeyDto> _keys = new();
    private Dictionary<string, List<LocalizationKeyDto>> _groupedKeys = new();
    private string _search = string.Empty;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadKeys();
    }

    private async Task LoadKeys()
    {
        _loading = true;

        _keys = await KeyService.GetAllKeysAsync();
        ApplySearch();

        _loading = false;
    }

    private void ApplySearch()
    {
        var filtered = string.IsNullOrWhiteSpace(_search)
            ? _keys
            : _keys.Where(k =>
                k.Key.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (k.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

        _groupedKeys = filtered
            .GroupBy(k => k.ModelName ?? "General")
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void CreateKey() => Nav.NavigateTo("/admin/localization/keys/create");
    private void EditKey(int id) => Nav.NavigateTo($"/admin/localization/keys/edit/{id}");

    private async Task DeleteKey(LocalizationKeyDto key)
    {
        await KeyService.DeleteKeyAsync(key.Id);
        await LoadKeys();
    }
}
