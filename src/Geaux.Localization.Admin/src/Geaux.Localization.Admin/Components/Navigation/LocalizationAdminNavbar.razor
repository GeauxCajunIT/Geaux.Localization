             CollapseIcon="@Icons.Material.Filled.ExpandLess"
             DefaultOpen="true">

    <MudNavLink Href="/admin/localization/dashboard"
                Icon="@Icons.Material.Filled.Dashboard"
                Match="NavLinkMatch.All">
        Dashboard
    </MudNavLink>

    <MudNavLink Href="/admin/localization/keys"
                Icon="@Icons.Material.Filled.Key">
        Keys
    </MudNavLink>

    <MudNavLink Href="/admin/localization/values"
                Icon="@Icons.Material.Filled.List">
        Values
    </MudNavLink>

    <MudNavLink Href="/admin/localization/cultures"
                Icon="@Icons.Material.Filled.Language">
        Cultures
    </MudNavLink>

    <MudNavLink Href="/admin/localization/language-packs"
                Icon="@Icons.Material.Filled.UploadFile">
