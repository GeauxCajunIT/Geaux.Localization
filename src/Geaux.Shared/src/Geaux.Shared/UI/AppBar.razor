@using Geaux.Localization.Admin.DTOs
@inject CultureAdminService CultureService
@inject NavigationManager Nav
@inject ThemeService ThemeService

<MudAppBar Elevation="1">
        <!-- Left side -->
        <MudText Typo="Typo.h6">Geaux Localization Admin</MudText>

        <MudSpacer />

        <!-- Theme Toggle -->
        @if (_initialized)
        {
            <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleTheme" />
        }

        <!-- Language Selector -->
         <MudMenu>
            <CultureFlag Culture="@_currentCulture" />

            @foreach (var c in _cultures)
            {
                <MudMenuItem OnClick="@(() => ChangeCulture(c.CultureCode))">
                    <CultureFlag Culture="@c" />
                    <span class="ml-2">@c.DisplayName (@c.CultureCode)</span>
                </MudMenuItem>
            }
        </MudMenu>
</MudAppBar>

@code {
    private List<LocalizationCultureDto> _cultures = new();
    private string _currentCulture;
    private string _currentCode = "en-US";
    private bool _isDark;
    private bool _initialized;

    protected override async Task OnInitializedAsync()
{
    // Load only active cultures
    var all = await CultureService.GetAllCulturesAsync();
    _cultures = all.Where(c => c.IsActive).ToList();

    // Determine current culture from URL
    var uri = Nav.ToAbsoluteUri(Nav.Uri);
    var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
    _currentCode = query["culture"] ?? "en-US";

    // Assign the actual DTO for the flag
    _currentCulture = _cultures.FirstOrDefault(c => c.CultureCode == _currentCode)
        ?? _cultures.FirstOrDefault();

    // ⭐ This is the missing piece — forces the activator to update
    StateHasChanged();
}


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            _isDark = ThemeService.IsDarkMode;
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await ThemeService.SetDarkMode(_isDark);
    }

    private void ChangeCulture(string culture)
    {
        Nav.NavigateTo($"/culture/set?culture={culture}", forceLoad: true);
    }
}
