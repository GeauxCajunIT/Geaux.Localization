{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "../src/**/bin/Release/net9.0/*.dll"
          ],
          "exclude": [
            "**/ref/**"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "properties": {
        "TargetFramework": "net9.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "articles/**.md",
          "articles/toc.yml",
          "api/**.yml",
          "api/index.md",
          "api/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "Geaux.Localization",
      "_appName": "Geaux.Localization",
      "_enableSearch": true,
      "pdf": false
    },
    "template": [
      "default",
      "modern"
    ],
    "markdownEngineName": "markdig",
    "xrefService": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ]
  }
}
